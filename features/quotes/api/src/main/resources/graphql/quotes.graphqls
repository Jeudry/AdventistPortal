extend type Query {
    myActiveQuote: Quote
}

extend type Mutation {
    addVariantToQuote(
        variantId: String!,
        quantity: Int!,
        startDate: String!,
        endDate: String!
    ): Quote
    confirmQuote(quoteId: String!): Quote
}

type Quote {
    id: ID!
    clientId: ID!
    status: QuoteStatus!
    eventStartDate: DateTime!
    eventEndDate: DateTime!
    venueAddress: String
    items: [QuoteItem]
    totalAmount: BigDecimal!
    createdAt: DateTime!
}

type QuoteItem {
    id: ID!
    variantId: UUID!
    quantity: Int!
    unitPrice: BigDecimal!
    totalPrice: BigDecimal!
    addedAt: DateTime!
}

enum QuoteStatus {
    DRAFT
    PENDING_REVIEW
    QUOTED
    RESERVED
    CANCELLED
    EXPIRED
}