scalar BigDecimal
scalar DateTime
scalar UUID

type Query {
    articles(id: ID, title: String, authorId: String): [ArticleSummary]
    article(id: ID!): Article
}

type Mutation {
    createArticle(input: CreateArticleInput!): ID
    updateArticle(input: UpdateArticleInput!): ID
    deleteArticle(id: ID!): Boolean
}

type ArticleDimension {
    label: String!
    widthCm: Float
    heightCm: Float
    depthCm: Float
    weightKg: Float
}

type ArticleVariant {
    id: UUID!
    sku: String!
    name: String!
    description: String
    imageUrl: String
    isActive: Boolean!
    stock: Int!
    "What it would cost to replace the item, for insurance and asset records."
    replacementCost: BigDecimal!
    attributes: [Attribute]
    dimensions: [ArticleDimension]
}

type Attribute {
    key: String!
    value: String!
}

type Article {
    id: ID!
    nameTemplate: String!
    descriptionTemplate: String
    isActive: Boolean!
    categoryId: ID
    variants: [ArticleVariant]
}

type ArticleSummary {
    id: ID!
    nameTemplate: String!
    descriptionTemplate: String
    createdAt: DateTime
}

input CreateArticleInput {
    nameTemplate: String!
    descriptionTemplate: String
    categoryId: ID
    variants: [CreateArticleVariantInput!]!
}

input CreateArticleVariantInput {
    sku: String!
    name: String!
    description: String
    imageUrl: String
    stock: Int!
    replacementCost: BigDecimal!
    attributes: [AttributeInput!]
    dimensions: [ArticleDimensionInput!]
}

input AttributeInput {
    key: String!
    value: String!
}

input ArticleDimensionInput {
    label: String!
    widthCm: Float
    heightCm: Float
    depthCm: Float
    weightKg: Float
}

input UpdateArticleInput {
    id: ID!
    nameTemplate: String
    descriptionTemplate: String
    isActive: Boolean
    categoryId: ID
}
