scalar Long
scalar DateTime
scalar UUID

type Query {
    articles(id: ID, title: String, authorId: String): [ArticleSummary]
    article(id: ID!): Article
    categories: [Category!]!
    category(id: ID!): Category
}

type Mutation {
    createArticle(input: CreateArticleInput!): ID
    updateArticle(input: UpdateArticleInput!): ID
    deleteArticle(id: ID!): Boolean
    createCategory(input: CreateCategoryInput!): ID
    updateCategory(input: UpdateCategoryInput!): ID
    deleteCategory(id: ID!): Boolean
}

"How the register is organised. A category may sit under another: furniture, then chairs."
type Category {
    id: ID!
    name: String!
    description: String
    iconName: String
    isActive: Boolean!
    parent: Category
    children: [Category!]!
}

input CreateCategoryInput {
    name: String!
    description: String
    iconName: String
    isActive: Boolean! = true
    parentId: ID
}

input UpdateCategoryInput {
    id: ID!
    name: String!
    description: String
    iconName: String
    isActive: Boolean!
    parentId: ID
}

type ArticleDimension {
    label: String!
    widthCm: Float
    heightCm: Float
    depthCm: Float
    weightKg: Float
}

type ArticleVariant {
    id: UUID!
    sku: String!
    name: String!
    description: String
    imageUrl: String
    isActive: Boolean!
    stock: Int!
    "Replacement value in cents, for insurance and asset records."
    replacementCostCents: Long!
    attributes: [Attribute]
    dimensions: [ArticleDimension]
}

type Attribute {
    key: String!
    value: String!
}

type Article {
    id: ID!
    nameTemplate: String!
    descriptionTemplate: String
    isActive: Boolean!
    categoryId: ID
    variants: [ArticleVariant]
}

type ArticleSummary {
    id: ID!
    nameTemplate: String!
    descriptionTemplate: String
    createdAt: DateTime
}

input CreateArticleInput {
    nameTemplate: String!
    descriptionTemplate: String
    categoryId: ID
    variants: [CreateArticleVariantInput!]!
}

input CreateArticleVariantInput {
    sku: String!
    name: String!
    description: String
    imageUrl: String
    stock: Int!
    replacementCostCents: Long!
    attributes: [AttributeInput!]
    dimensions: [ArticleDimensionInput!]
}

input AttributeInput {
    key: String!
    value: String!
}

input ArticleDimensionInput {
    label: String!
    widthCm: Float
    heightCm: Float
    depthCm: Float
    weightKg: Float
}

input UpdateArticleInput {
    id: ID!
    nameTemplate: String
    descriptionTemplate: String
    isActive: Boolean
    categoryId: ID
}
