<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="create-schemas" author="sargon">
        <sql>
            CREATE SCHEMA IF NOT EXISTS chat_service;
            CREATE SCHEMA IF NOT EXISTS user_service;
            CREATE SCHEMA IF NOT EXISTS notification_service;
            CREATE SCHEMA IF NOT EXISTS inventory_service;
            CREATE SCHEMA IF NOT EXISTS quote_service;
        </sql>
    </changeSet>

    <changeSet id="1770754070437-1" author="sargon">
        <createTable schemaName="inventory_service" tableName="article_variant_attributes">
            <column name="variant_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_article_variant_attributes"/>
            </column>
            <column name="attribute_value" type="VARCHAR(255)"/>
            <column name="attribute_key" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_article_variant_attributes"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1770754070437-2" author="sargon">
        <createTable schemaName="inventory_service" tableName="article_variant_dimensions">
            <column name="variant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(255)"/>
            <column name="width_cm" type="DOUBLE"/>
            <column name="height_cm" type="DOUBLE"/>
            <column name="depth_cm" type="DOUBLE"/>
            <column name="weight_kg" type="DOUBLE"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754070437-3" author="sargon">
        <createTable schemaName="inventory_service" tableName="article_variants">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_article_variants"/>
            </column>
            <column name="sku" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="image_url" type="VARCHAR(255)"/>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="stock" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="rental_price" type="DECIMAL(19, 4)"/>
            <column name="sale_price" type="DECIMAL(19, 4)"/>
            <column name="replacement_cost" type="DECIMAL(19, 4)"/>
            <column name="article_id" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754070437-4" author="sargon">
        <createTable schemaName="inventory_service" tableName="categories">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_categories"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="icon_name" type="VARCHAR(255)"/>
            <column name="is_active" type="BOOLEAN"/>
            <column name="parent_id" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754070437-5" author="sargon">
        <createTable schemaName="inventory_service" tableName="discounts">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_discounts"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATETIME"/>
            <column name="end_date" type="DATETIME"/>
            <column name="is_active" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="target_category_id" type="UUID"/>
            <column name="target_article_id" type="UUID"/>
            <column name="target_variant_id" type="UUID"/>
            <column name="priority" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME"/>
            <column name="updated_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754070437-6" author="sargon">
        <addColumn schemaName="inventory_service" tableName="articles">
            <column name="category_id" type="UUID"/>
            <column name="created_at" type="DATETIME"/>
            <column name="description_template" type="TEXT"/>
            <column name="is_active" type="BOOLEAN"/>
            <column name="name_template" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
        </addColumn>
    </changeSet>
    <changeSet id="1770754070437-10" author="sargon">
        <addNotNullConstraint columnName="is_active" schemaName="inventory_service" tableName="articles"/>
    </changeSet>
    <changeSet id="1770754070437-12" author="sargon">
        <addNotNullConstraint columnName="name_template" schemaName="inventory_service" tableName="articles"/>
    </changeSet>
    <changeSet id="1770754070437-14" author="sargon">
        <addNotNullConstraint columnName="type" schemaName="inventory_service" tableName="articles"/>
    </changeSet>
    <changeSet id="1770754070437-16" author="sargon">
        <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="articles"
                                 baseTableSchemaName="inventory_service" constraintName="FK_ARTICLES_ON_CATEGORY"
                                 referencedColumnNames="id" referencedTableName="categories"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>
    <changeSet id="1770754070437-17" author="sargon">
        <addForeignKeyConstraint baseColumnNames="article_id" baseTableName="article_variants"
                                 baseTableSchemaName="inventory_service" constraintName="FK_ARTICLE_VARIANTS_ON_ARTICLE"
                                 referencedColumnNames="id" referencedTableName="articles"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>
    <changeSet id="1770754070437-18" author="sargon">
        <addForeignKeyConstraint baseColumnNames="parent_id" baseTableName="categories"
                                 baseTableSchemaName="inventory_service" constraintName="FK_CATEGORIES_ON_PARENT"
                                 referencedColumnNames="id" referencedTableName="categories"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>
    <changeSet id="1770754070437-19" author="sargon">
        <addForeignKeyConstraint baseColumnNames="variant_id" baseTableName="article_variant_attributes"
                                 baseTableSchemaName="inventory_service"
                                 constraintName="fk_article_variant_attributes_on_article_variant_entity"
                                 referencedColumnNames="id" referencedTableName="article_variants"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>
    <changeSet id="1770754070437-20" author="sargon">
        <addForeignKeyConstraint baseColumnNames="variant_id" baseTableName="article_variant_dimensions"
                                 baseTableSchemaName="inventory_service"
                                 constraintName="fk_article_variant_dimensions_on_article_variant_entity"
                                 referencedColumnNames="id" referencedTableName="article_variants"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>
    <changeSet id="1770754070437-21" author="sargon">
        <dropColumn columnName="code" schemaName="inventory_service" tableName="articles"/>

        <dropColumn columnName="name" schemaName="inventory_service" tableName="articles"/>
    </changeSet>
    <changeSet id="1770754072312-1" author="sargon">
        <createTable schemaName="quote_service" tableName="quote_items">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_quote_items"/>
            </column>
            <column name="quote_id" type="UUID"/>
            <column name="variant_id" type="UUID"/>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="DECIMAL(19, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="added_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754072312-2" author="sargon">
        <createTable schemaName="quote_service" tableName="quotes">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_quotes"/>
            </column>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="event_start_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="event_end_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="venue_address" type="VARCHAR(255)"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>
    <changeSet id="1770754072312-3" author="sargon">
        <addForeignKeyConstraint baseColumnNames="quote_id" baseTableName="quote_items"
                                 baseTableSchemaName="quote_service" constraintName="FK_QUOTE_ITEMS_ON_QUOTE"
                                 referencedColumnNames="id" referencedTableName="quotes"
                                 referencedTableSchemaName="quote_service"/>
    </changeSet>
    <changeSet id="1770754072312-4" author="sargon">
        <addForeignKeyConstraint baseColumnNames="variant_id" baseTableName="quote_items"
                                 baseTableSchemaName="quote_service" constraintName="FK_QUOTE_ITEMS_ON_VARIANT"
                                 referencedColumnNames="id" referencedTableName="article_variants"
                                 referencedTableSchemaName="inventory_service"/>
    </changeSet>

</databaseChangeLog>