# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/app/src/main/resources/firebase-credentials/adventist-firebase-adminsdk.json
app/src/main/resources/firebase-credentials/adventist-firebase-adminsdk.json

.kotlin/app/src/main/resources/firebase-credentials/google-services.json

# Ignorar credenciales de Firebase
.kotlin/app/src/main/resources/firebase-credentials/

# Ignorar google-services.json en cualquier ubicación
**/google-services.json

# Ignorar cualquier carpeta firebase-credentials en cualquier parte del proyecto
**/firebase-credentials/

# Ignorar archivos de configuración sensibles
.env
.env.*
*.env
scripts/.env.local

# Ignorar run configurations con credenciales (solo subir templates)
.run/*[DEV]*.xml
.run/*[PROD]*.xml
.idea/runConfigurations/*[DEV]*.xml
.idea/runConfigurations/*[PROD]*.xml

# Ignorar carpetas de compilación y binarios (ya cubierto, pero se refuerza)
build/
*/build/
app/build/
bin/
*/bin/
**/bin/

# Ignorar archivos temporales y de sistema
*.tmp
*.swp
*.swo
.DS_Store

# Ignorar carpetas de Gradle
.gradle/

# Ignorar archivos de IDE
.idea/
*.iml
*.iws
*.ipr

# Excepciones para que gradle-wrapper.properties y gradle-wrapper.jar no sean ignorados
# (en cualquier subproyecto, p.ej. el cliente KMP)
!**/gradle/wrapper/gradle-wrapper.properties
!**/gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradle/wrapper/gradle-wrapper.jar
*.hprof
